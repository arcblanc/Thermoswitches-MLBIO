EMAIL=your.email@university.edu
NCBI_API_KEY=your_ncbi_api_key_here

# Optional: Hugging Face token for gated models / faster downloads
HF_TOKEN=

# GenerRNA asset cache (gitignored under models/)
GENERNA_CACHE_DIR=models/genererna

# BiRNA-BERT Hugging Face IDs
BIRNA_TOKENIZER_ID=buetnlpbio/birna-tokenizer
BIRNA_MODEL_ID=buetnlpbio/birna-bert

# LLM smoke-test output directories (repo-relative)
EMBEDDING_OUTPUT_DIR=data/processed/validation_embedding
DE_NOVO_OUTPUT_DIR=data/processed/de_novo

# Storage: local | gcs | s3 | runpod
STORAGE_TARGET=local

# AWS S3 — RunPod LLM batch (GenerRNA + BiRNA upload)
AWS_S3_BUCKET=thermo-s3-bucket
AWS_REGION=us-east-1
AWS_S3_PREFIX=llm-batch/v1

# RunPod (Thermopod — 1x A100 80GB) — SSH only, NO SCP/SFTP
# REST API pod id (NOT the SSH username). SSH user may be "{podId}-{suffix}".
RUNPOD_POD_ID=x0ggh3d7lmi9yn
RUNPOD_SSH_USER=x0ggh3d7lmi9yn-64410a9d
RUNPOD_SSH_HOST=ssh.runpod.io
RUNPOD_SSH_KEY=~/.ssh/id_ed25519
RUNPOD_API_KEY=
# Stop the pod after any standalone GenerRNA/BiRNA job, or after llm_cloud_batch.py.
RUNPOD_AUTO_TERMINATE=true

# Connect: ssh ${RUNPOD_SSH_USER}@${RUNPOD_SSH_HOST} -i ${RUNPOD_SSH_KEY}

# EC2 thermo batch — already running, SCP access (not RunPod)
EC2_INSTANCE_NAME=aws-thermo-ec2
EC2_HOST=
EC2_INSTANCE_ID=
EC2_REGION=          # instance region (may differ from AWS_REGION / S3)
EC2_USER=ubuntu
EC2_SSH_KEY=~/.ssh/aws-thermo-ec2.pem
EC2_REPO_PATH=~/Thermoswitches-MLBIO
EC2_AUTO_SHUTDOWN=true

# GCP (legacy Spot VM path)
GCS_BUCKET=your-bucket
GCS_PREFIX=llm-batch/v1
VM_AUTO_SHUTDOWN=false

GENERNA_BATCH_SIZE=50
GENERNA_NUM_SAMPLES=10000

# ---------------------------------------------------------------------------
# EVA (Option B diverse panel — official CLI TaxID wrapper builds Greengenes)
# Prefer AWS_S3_PREFIX=llm-batch/eva/v1 when running EVA so artifacts stay
# separate from GenerRNA llm-batch/v1.
# ---------------------------------------------------------------------------
EVA_CACHE_DIR=models/eva
EVA_CHECKPOINT_DIR=models/eva/checkpoint
EVA_NUM_SAMPLES=16
EVA_CHUNK_SIZE=512
EVA_MIN_LEN=40
EVA_MAX_LEN=600
EVA_RNA_TYPE=mRNA
# EVA_SMOKE_SINGLE_HOST=1   # optional: smoke E. coli only
EVA_PANEL_ECOLI_TAXID=562
EVA_PANEL_ECOLI_N=3334
EVA_PANEL_SALMONELLA_TAXID=28901
EVA_PANEL_SALMONELLA_N=3333
EVA_PANEL_LISTERIA_TAXID=1639
EVA_PANEL_LISTERIA_N=3333
# Optional: path to eva-generate if not on PATH
# EVA_GENERATE_BIN=
