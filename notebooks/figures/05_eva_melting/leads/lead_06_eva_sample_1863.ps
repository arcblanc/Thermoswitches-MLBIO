GAGAAUAUCUCAUACUUGGCGCAUUCCAAGCUGUCCAGGAAGGUGUCGGGGUACCUCAGCAAGAGUUCACUGAAAUAAGCCUUGGGCAAA\
) } def
/len { sequence length } bind def

