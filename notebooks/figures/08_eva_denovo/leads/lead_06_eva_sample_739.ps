GCCGCCGCCACCGGCCCCACGCACGCGGACGGCGGCAUGAACGACCUCGCCAUCGGCGCCGACCUGACCCUCAUCAAGUUCGCCAUCGCC\
) } def
/len { sequence length } bind def

