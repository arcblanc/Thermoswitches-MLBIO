AUGACGUCGAUGGUGAAGAUAUUGACAAGGAACAUGAAGAAAUCCAUGGCAUUAUUGACGACAUCGACAGUGUUGAUGAUGCACAUGGCG\
) } def
/len { sequence length } bind def

